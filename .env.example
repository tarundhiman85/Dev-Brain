POSTGRES_DB=devbrain
POSTGRES_USER=devbrain
POSTGRES_PASSWORD=devbrain_local
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://devbrain:devbrain_local@localhost:5432/devbrain
EMBEDDING_PROVIDER=local
# For OpenAI, set EMBEDDING_PROVIDER=openai and supply this key.
OPENAI_API_KEY=
# Phase 2 GitHub access and Phase 3 agent chat settings.
GITHUB_TOKEN=
DEVBRAIN_AGENT_MODEL=
TAVILY_API_KEY=
# Phase 4 local chat and optional Ollama embeddings.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=llama3.2
DEVBRAIN_ALLOW_CLOUD_FALLBACK=false
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_EMBEDDING_DIMENSIONS=768
# Phase 5 judge model. Uses OPENAI_API_KEY.
DEVBRAIN_JUDGE_MODEL=gpt-4o
# Phase 6 browser origins. Use a JSON array of exact origins.
DEVBRAIN_UI_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
